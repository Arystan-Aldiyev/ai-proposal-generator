# Скопируй в .env и подставь свой ключ
OPENAI_API_KEY=sk-...

# Модели по умолчанию заданы в app/config.py (итоговая конфигурация):
# extractor/risk — gpt-4o-mini, estimator/writer/reviser — gpt-4o.
# Переопределять через MODEL_EXTRACTOR=... и т.п. только для экспериментов.
EMBEDDING_MODEL=text-embedding-3-small

# Опционально: fallback провайдер при сбоях OpenAI. Без ключа no-op.
# ANTHROPIC_API_KEY=

# Контакты в футере PDF (персональные данные в код не кладём)
AGENCY_MANAGER=Менеджер Фамильевич
AGENCY_PHONE=+77071234567
AGENCY_EMAIL=info@agency.kz
AGENCY_LEGAL=

# LangSmith observability (опционально)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cns-proposal
# EU-инстанс LangSmith требует endpoint; US-инстансу — можно оставить пустым.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Доступ к веб-интерфейсу: с паролем все страницы требуют HTTP Basic.
# Обязательно задайте, если приложение доступно не только с localhost.
APP_USER=admin
APP_PASSWORD=

# Telegram-бот. Без токена бот не стартует.
TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000
